# Copy this file to .env and fill in real values. NEVER commit .env.

# ============================================================
# LLM provider — cascade order: AI Studio -> Vertex -> Anthropic
# ============================================================

# Google AI Studio (primary, may hit 403 PERMISSION_DENIED on some projects)
GEMINI_API_KEY=

# Google Vertex AI (fallback when AI Studio denied)
# Path to service-account JSON. Use absolute Windows path with backslashes.
VERTEX_AI_CREDENTIALS=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global

# Anthropic (last-resort fallback for content gen)
ANTHROPIC_API_KEY=

# ============================================================
# MathPix OCR (Stage 1)
# ============================================================
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ============================================================
# Optional — observability (intern branch feat/observability)
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
